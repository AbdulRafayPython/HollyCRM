# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server routes only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Green API ----
# Per-instance host shown as "apiUrl" in the console, e.g. https://7107.api.greenapi.com
# Falls back to the legacy shared host if unset.
GREEN_API_BASE_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN=
# Set the same value in Green API console -> Settings -> webhookUrlToken.
# Inbound requests without a matching Bearer header are rejected. (C6)
GREEN_API_WEBHOOK_TOKEN=
# Unguessable path segment: /api/webhook/green/<this>
GREEN_API_WEBHOOK_SECRET=change-me-to-something-random
# The instance's own JID, e.g. 9665XXXXXXXX@c.us — used to detect @mentions in groups (E2)
GREEN_API_OWN_JID=

# ---- WasenderAPI (second WhatsApp gateway; optional) ----
# Unguessable path segment: /api/webhook/wasender/<this>
# The per-session API key and webhook secret are NOT set here — they are entered
# per workspace in Settings → WhatsApp and stored in wasender_sessions.
WASENDER_WEBHOOK_SECRET=change-me-to-something-random
# Override only if WasenderAPI ever moves off their default host.
WASENDER_BASE_URL=https://www.wasenderapi.com

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat only. deepseek-reasoner emits a reasoning trace and blows the latency budget.
DEEPSEEK_MODEL=deepseek-chat

# ---- Demo ----
# The org id printed by 0002_demo_seed.sql
DEMO_ORG_ID=
