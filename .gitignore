# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js build output ----
# next.config.ts sets distDir from NEXT_DIST_DIR, so builds land in
# .next, .next-build, .next-e2e, ... — ignore the whole family.
/.next/
/.next-*/
/out/
/build/
/dist/

# ---- Vercel ----
.vercel/

# ---- Environment / secrets ----
# .env.example is the committed template; everything else stays local.
.env
.env.*
!.env.example

# ---- Local tooling config (machine-specific, holds project refs/tokens) ----
.mcp.json
.claude/settings.local.json

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Testing / coverage ----
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
*.lcov

# ---- Supabase CLI local state (migrations stay tracked) ----
supabase/.temp/
supabase/.branches/
supabase/logs/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editors / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Misc ----
*.pem
.cache/
.turbo/
tmp/
temp/
