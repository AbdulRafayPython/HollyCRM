# ---- Dependencies ----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---- Next.js build output ----
# next.config.ts sets distDir from NEXT_DIST_DIR, so builds land in
# .next, .next-build, .next-e2e, ... — ignore the whole family.
/.next/
/.next-*/
/out/
/build/
/dist/

# ---- Vercel ----
.vercel/

# ---- Environment / secrets ----
# .env.example is the committed template; everything else stays local.
# .env.local contains real Supabase, Green API, and DeepSeek keys — NEVER push.
.env
.env.*
!.env.example

# ---- Local tooling config (machine-specific, holds project refs/tokens) ----
.mcp.json
.claude/settings.local.json

# ---- TypeScript ----
*.tsbuildinfo
next-env.d.ts

# ---- Testing / coverage ----
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
*.lcov

# ---- Supabase CLI local state (migrations stay tracked) ----
supabase/.temp/
supabase/.branches/
supabase/logs/

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editors / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Misc ----
*.pem
.cache/
.turbo/
tmp/
temp/

# ===========================================================================
#  UNUSED / REFERENCE-ONLY ASSETS
#  Design references, prototypes, image-generation sources and duplicates that
#  no source file loads.
#
#  The only image directories the app actually serves are:
#    public/landing/   — the landing + auth photography and 3D renders (WebP)
#    public/banners/   — the three integration banners on settings/whatsapp
#
#  public/landing-assets/ used to serve the landing page. It no longer does:
#  those were AI-generated UI screenshots whose text was hallucinated and whose
#  brand name predated the Holly -> Holy rename. Every one was replaced by real
#  markup or by the WebP set in public/landing/.
# ===========================================================================

# -- Root-level duplicate asset folders --
# Exact byte-for-byte copies of files already in public/landing-assets/
/landing-assets/

# UI prototype screenshots (not referenced anywhere in src/)
/frontend Ui/

# -- Stitch / Google design workspace --
# Contains DESIGN.md, competitor screenshots, and generated design mockups.
# Only referenced in a tailwind.config.ts comment — not loaded at runtime.
/stitch_hollycrm_whatsapp_workstation/

# -- Unused files inside public/ --

# Source PNGs handed to the image generator, kept only until they were
# converted into the WebP set in public/landing/. Tens of MB, never served.
public/Gpt images/

# Reference showreels the landing page motion was derived from. Not shipped.
public/4dea10d5c1dbe4727dd6cf2469130569.mp4
public/original-50b3b12780545edf5499079baf99bc77.mp4

# UUID-named image (duplicate of ai_quoting_flow_diagram.png) — unused
public/28405ba1-bc0b-4d04-a969-591e7821f953.png

# Logo JPGs in public root — app uses the SVG <HolyCrmLogo /> component instead
public/hollycrm_brand_logo.jpg
public/hollycrm_logo.jpg
public/logo.jpg

# Standalone quoting flow image in root (code loads /landing-assets/ version)
public/ai_quoting_flow.png

# Frame-by-frame extractions of the reference showreels, plus a source ZIP.
# Used once to read the reference's motion; nothing loads them.
public/ezgif-3e207b37f206995c-jpg/
public/ezgif-3e207b37f206995c-jpg.zip
public/ezgif-887ce1c1dca09140-jpg/

# UI prototype thumbnails duplicated from "frontend Ui/" — not used in code
public/frontend-ui/

# The whole generated-screenshot set. Superseded by real markup and by
# public/landing/ — see the note at the top of this section.
public/landing-assets/
